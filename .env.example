# Resend API key — sign up at https://resend.com (free tier: 100 emails/day, 3k/month)
RESEND_API_KEY=

# Verified sender address in Resend. Until you verify a custom domain in Resend,
# you can only send FROM onboarding@resend.dev (to yourself only).
# After verifying southweststucco.net in Resend, switch this to e.g. noreply@southweststucco.net
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=Southweststucco@gmail.com

# Public site URL — used in sitemap.xml, robots.txt, canonical tags, OG metadata.
# In Vercel, set this to https://southweststucco.net once the domain is connected.
NEXT_PUBLIC_SITE_URL=https://southweststucco.net
